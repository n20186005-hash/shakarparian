---
interface Props { compact?: boolean; href?: string; }
const { compact = false, href = '/' } = Astro.props;
---
<a href={href} class="brand-mini" aria-label="شکرپڑیاں رہنما — مرکزی صفحہ">
  <img src="/brand/favicon.svg" width="46" height="46" alt="" aria-hidden="true" />
  <span>شکرپڑیاں رہنما</span>
</a>
