---
import { FACILITY_GROUPS } from '../data/visitor';
import { localeFromUrl, type Locale } from '../i18n';

const locale: Locale = localeFromUrl(Astro.url);
const L = locale === 'en' ? {
  eyebrow: 'Visitor facilities',
  title: 'Facilities to ask about before visiting',
  lead: 'Shakarparian is a public green area, so facilities are basic. The following are planning questions, not a verified inventory; ask the relevant operator.',
} : {
  eyebrow: 'زائرین کی سہولیات',
  title: 'روانگی سے پہلے سہولیات معلوم کریں',
  lead: 'شکرپڑیاں ایک عوامی سبز علاقہ ہے، اس لیے سہولیات بنیادی نوعیت کی ہیں۔ ذیل کے نکات منصوبہ بندی کے سوالات ہیں، تصدیق شدہ فہرست نہیں؛ متعلقہ ادارے سے معلوم کریں۔',
};
---
<section class="section-sm" aria-labelledby="facilities-title">
  <div class="container">
    <div class="eyebrow">{L.eyebrow}</div>
    <h2 class="section-title" id="facilities-title">{L.title}</h2>
    <p class="section-lead">{L.lead}</p>
    <div class="feature-grid">
      {
        FACILITY_GROUPS.map((f) => (
          <article class="feature">
            <div class="icon" aria-hidden="true">{f.icon}</div>
            <h3>{locale === 'en' ? f.titleEn : f.title}</h3>
            <p>{locale === 'en' ? f.bodyEn : f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
