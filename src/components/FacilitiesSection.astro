---
import { FACILITY_GROUPS } from '../data/visitor';
import { localeFromUrl, type Locale } from '../i18n';

const locale: Locale = localeFromUrl(Astro.url);
const L = locale === 'en' ? {
  eyebrow: 'Visitor facilities',
  title: 'Facilities available during the visit',
  lead: 'Shakarparian is a public green area, so facilities are basic. The list below is compiled from public material; availability can vary by point, so confirm on the day.',
} : {
  eyebrow: 'زائرین کی سہولیات',
  title: 'دورے کے دوران دستیاب سہولیات',
  lead: 'شکرپڑیاں ایک عوامی سبز علاقہ ہے، اس لیے سہولیات بنیادی نوعیت کی ہیں۔ ذیل کی فہرست عوامی مواد سے مرتب ہے؛ دستیابی پوائنٹ کے لحاظ سے مختلف ہو سکتی ہے، اس لیے دن میں تصدیق کر لیں۔',
};
---
<section class="section-sm" aria-labelledby="facilities-title">
  <div class="container">
    <div class="eyebrow">{L.eyebrow}</div>
    <h2 class="section-title" id="facilities-title">{L.title}</h2>
    <p class="section-lead">{L.lead}</p>
    <div class="feature-grid">
      {
        FACILITY_GROUPS.map((f) => (
          <article class="feature">
            <div class="icon" aria-hidden="true">{f.icon}</div>
            <h3>{locale === 'en' ? f.titleEn : f.title}</h3>
            <p>{locale === 'en' ? f.bodyEn : f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
