---
import { AUDIENCE_ROUTES } from '../data/visitor';
import { ATTRACTION } from '../data/site';
---

<section class="section" id="routes" aria-labelledby="routes-title">
  <div class="container">
    <div class="eyebrow">آبادی کے لحاظ سے راستے</div>
    <h2 class="section-title" id="routes-title">{ATTRACTION.shortName} کے لیے تین مخصوص سفری راستے</h2>
    <p class="section-lead">اپنے سفری گروپ اور رفتار کے مطابق ایک راستہ چنیں — خاندان، فوٹوگرافی یا کم نقل و حرکت والے ساتھیوں کے لیے۔</p>
    <div class="route-grid">
      {AUDIENCE_ROUTES.map((r) => (
        <article class="route-card">
          <div class="route-head"><span class="route-icon" aria-hidden="true">{r.icon}</span><h3>{r.title}</h3></div>
          <p class="route-audience">{r.audience}</p>
          <ol class="route-steps">
            {r.steps.map((s) => <li>{s}</li>)}
          </ol>
          <p class="route-tip">💡 {r.tips}</p>
        </article>
      ))}
    </div>
  </div>
</section>
