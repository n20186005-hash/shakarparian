---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTopic, type TopicContent, type TopicLocale } from '../data/topics';
import { SITE_URL } from '../data/site';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildWebPageSchema,
} from '../lib/schema';

interface Props {
  locale: TopicLocale;
  slug: string;
}
const { locale, slug } = Astro.props;
const topic = getTopic(slug);
const isEn = locale === 'en';
// topics.ts always carries both languages, so this is non-null for a published slug
const c: TopicContent = isEn ? topic!.en : topic!.ur;
const cOther: TopicContent = isEn ? topic!.ur : topic!.en;

const path = Astro.url.pathname; // e.g. /en/viewpoint/ or /viewpoint/
const canonical = `${SITE_URL}${path}`;

const webPage = buildWebPageSchema({
  url: canonical,
  name: c.h1,
  nameLatin: cOther.h1,
  description: c.description,
  inLanguage: isEn ? 'en' : 'ur',
});
const breadcrumb = buildBreadcrumbSchema(canonical, { name: isEn ? c.h1En : c.h1, nameLatin: cOther.h1 });
const faqPairs = c.faqs.map((f) => (isEn ? [f.qEn, f.aEn] : [f.q, f.a])) as [string, string][];
const faqSchema = c.faqs.length ? buildFaqSchema(faqPairs) : null;
const schema = [webPage, breadcrumb, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={isEn ? c.titleEn : c.title}
  description={isEn ? c.descriptionEn : c.description}
  ogTitle={isEn ? c.h1En : c.h1}
>
  {schema.map((s) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(s)}></script>
  ))}

  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      <ol class="breadcrumbs">
        <li>
          <a class="bc-ur" href={isEn ? '/en/' : '/'}>{isEn ? 'Home' : 'مرکزی صفحہ'}</a>
        </li>
        <li aria-current="page"><span class="bc-ur">{isEn ? c.h1En : c.h1}</span></li>
      </ol>
    </div>
  </nav>

  <section class="section-sm">
    <div class="container">
      <p class="eyebrow">{isEn ? c.kickerEn : c.kicker}</p>
      <h1 class="page-h1">{isEn ? c.h1En : c.h1}</h1>
      <p class="section-lead">{isEn ? c.leadEn : c.lead}</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      {
        c.sections.map((s) => (
          <div class="topic-block">
            <h2 class="block-title">{isEn ? s.headingEn : s.heading}</h2>
            <p class="block-body">{isEn ? s.bodyEn : s.body}</p>
            {s.bullets && s.bullets.length > 0 && (
              <ul class="block-list">
                {(isEn ? s.bulletsEn! : s.bullets).map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>

  {
    c.faqs.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <h2 class="block-title">{isEn ? 'Frequently asked questions' : 'عمومی سوالات'}</h2>
          <div class="faq-list">
            {c.faqs.map((f) => (
              <details>
                <summary>{isEn ? f.qEn : f.q}</summary>
                <p>{isEn ? f.aEn : f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    c.related.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <h2 class="block-title">{isEn ? 'Related guides' : 'متعلقہ رہنمائی'}</h2>
          <div class="related-grid">
            {c.related.map((rel) => {
              const t = getTopic(rel);
              if (!t) return null;
              const tc = isEn ? t.en : t.ur;
              const href = isEn ? `/en/${rel}/` : `/${rel}/`;
              return (
                <a class="related-card" href={href}>
                  <h3>{isEn ? tc.titleEn : tc.title}</h3>
                  <p>{isEn ? tc.descriptionEn : tc.description}</p>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <section class="section-sm">
    <div class="container">
      <div class="source-box">
        <p>
          {isEn
            ? 'This is an independent, non-commercial visitor guide. It is not the official site of any park or monument, and the Google Maps rating shown on the main page is a third-party summary, not a collection of reviews by this site.'
            : 'یہ ایک آزاد، غیر تجارتی رہنمائی ہے۔ یہ کسی پارک یا یادگار کی سرکاری سائٹ نہیں ہے، اور مرکزی صفحے پر دکھایا گیا گوگل میپس کا ریٹنگ ایک تھرڈ پارٹی خلاصہ ہے، اس سائٹ کی جمع کردہ رائے نہیں۔'}
        </p>
        <p class="source-meta">{isEn ? c.updatedEn : c.updated}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-h1 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.18;
    margin: 0 0 1rem;
    color: var(--pine);
    font-weight: 800;
  }
  .topic-block { margin-bottom: 2.5rem; }
  .block-title {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    margin: 0 0 .7rem;
    color: var(--pine);
    font-weight: 800;
  }
  .block-body { color: var(--muted); margin: 0; line-height: 1.7; }
  .block-list { margin: .8rem 0 0; padding-inline-start: 1.3rem; color: var(--muted); display: grid; gap: .4rem; }
  .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 1rem; }
  .related-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    padding: 1.2rem 1.3rem;
    background: #fff;
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .related-card:hover { border-color: var(--clay); transform: translateY(-2px); }
  .related-card h3 { margin: 0 0 .4rem; color: var(--pine); font-size: 1.08rem; }
  .related-card p { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.55; }
  @media (max-width: 640px) { .related-grid { grid-template-columns: 1fr; } }
</style>
