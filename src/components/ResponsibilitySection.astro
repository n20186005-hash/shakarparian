---
import { RESPONSIBILITY_GROUPS } from '../data/visitor';
import { localeFromUrl, type Locale } from '../i18n';

const locale: Locale = localeFromUrl(Astro.url);
const L = locale === 'en' ? {
  eyebrow: 'Visitor responsibility',
  title: 'Keep Shakarparian clean & safe',
  lead: 'A few simple habits protect the greenery, wildlife, and the experience of everyone who visits.',
} : {
  eyebrow: 'زائرین کی ذمہ داری',
  title: 'شکرپڑیاں کو صاف اور محفوظ رکھیں',
  lead: 'چند سادہ عادات سبزہ، جنگلی حیات اور ہر آنے والے کے تجربے کو محفوظ رکھتی ہیں۔',
};
---
<section class="section-sm deep-green" aria-labelledby="responsibility-title">
  <div class="container">
    <div class="eyebrow">{L.eyebrow}</div>
    <h2 class="section-title" id="responsibility-title">{L.title}</h2>
    <p class="section-lead">{L.lead}</p>
    <div class="guide-grid">
      {
        RESPONSIBILITY_GROUPS.map((g) => (
          <article class="guide-card">
            <div class="icon" aria-hidden="true">{g.icon}</div>
            <h3>{locale === 'en' ? g.titleEn : g.title}</h3>
            <p>{locale === 'en' ? g.bodyEn : g.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
