---
import { ATTRACTION } from '../data/site';
import { localeFromUrl, type Locale } from '../i18n';

interface Props {
  /** موجودہ صفحہ کا slug تاکہ اسے فہرست میں چھوڑ دیا جائے */
  exclude?: string;
  heading?: string;
  showHome?: boolean;
}
const { exclude = '', heading, showHome = true } = Astro.props;
const locale: Locale = localeFromUrl(Astro.url);

const guides = [
  {
    slug: 'pakistan-monument',
    ur: { ur: 'پاکستان مونومنٹ اور میوزیم', latin: 'Pakistan Monument & Museum', desc: 'قومی وحدت کی علامتی یادگار اور اندرونی نمائش کا تعارف۔' },
    en: { ur: 'Pakistan Monument & Museum', latin: 'Pakistan Monument & Museum', desc: 'Introduction to the national unity monument and its indoor exhibition.' },
  },
  {
    slug: 'opening-hours',
    ur: { ur: 'اوقات اور بہترین وقت', latin: 'Opening Hours & Best Time', desc: 'موجودہ عمومی اوقات، موسموں کا موازنہ اور ہجوم سے بچنے کا بہترین وقت۔' },
    en: { ur: 'Opening Hours & Best Time', latin: 'Opening Hours & Best Time', desc: 'Current general hours, seasonal comparison, and the best time to avoid crowds.' },
  },
  {
    slug: 'things-to-do',
    ur: { ur: 'پارک میں کیا کریں اور پکنک', latin: 'Things to Do & Picnic', desc: 'شہر کا نظارہ، یادگاری شجرکاری، فوٹوگرافی اور پکنک کی عملی رہنمائی۔' },
    en: { ur: 'Things to Do & Picnic', latin: 'Things to Do & Picnic', desc: 'City viewpoint, memorial planting, photography, and practical picnic guidance.' },
  },
  {
    slug: 'getting-there',
    ur: { ur: 'پہنچنا اور پارکنگ', latin: 'Getting There & Parking', desc: 'ہوائی اڈے، میٹروبس، ٹیکسی، نجی گاڑی اور پارکنگ کی تفصیلی وضاحت۔' },
    en: { ur: 'Getting There & Parking', latin: 'Getting There & Parking', desc: 'Airport, metrobus, taxi, private car, and detailed parking explanation.' },
  },
];
const shown = guides.filter((g) => g.slug !== exclude).map((g) => g[locale]);
const langBase = locale === 'en' ? '/en' : '';
const defaultHeading = locale === 'en' ? 'More detailed sub-guides' : 'مزید تفصیلی ذیلی رہنما';
const resolvedHeading = heading ?? defaultHeading;
const homeTitle = locale === 'en' ? `Main guide: ${ATTRACTION.fullNameLatin}` : `مرکزی رہنما: ${ATTRACTION.fullName}`;
const homeDesc = locale === 'en'
  ? 'The main page for location, map, transport, facilities, and frequently asked questions.'
  : 'مقام، نقشہ، آمدورفت، سہولیات اور عمومی سوالات کا مرکزی صفحہ۔';
const homeLatin = locale === 'en' ? `${ATTRACTION.fullNameLatin} — Main Guide` : `${ATTRACTION.fullNameLatin} — مرکزی رہنما`;
---
<section class="section-sm" aria-labelledby="related-title">
  <div class="container">
    <div class="eyebrow">{locale === 'en' ? 'Related guides' : 'متعلقہ رہنما'}</div>
    <h2 class="section-title" id="related-title">{resolvedHeading}</h2>
    <div class="relgrid">
      {
        shown.map((g) => (
          <a class="relcard" href={`${langBase}/${g.slug}/`}>
            <h3>{g.ur}</h3>
            <p>{g.desc}</p>
            <span class="rel-latin" dir="ltr">{g.latin}</span>
          </a>
        ))
      }
      {showHome && (
        <a class="relcard" href={locale === 'en' ? '/en/' : '/'}>
          <h3>{homeTitle}</h3>
          <p>{homeDesc}</p>
          <span class="rel-latin" dir="ltr">{homeLatin}</span>
        </a>
      )}
    </div>
  </div>
</section>
