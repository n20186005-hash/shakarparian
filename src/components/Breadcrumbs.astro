---
import { ATTRACTION, SITE_URL } from '../data/site';

interface Props {
  /** ذیلی صفحہ کا موجودہ کرما (نام + رومن نام)۔ خالی رہے تو مقام/ہوم خود موجودہ صفحہ ہے۔ */
  current?: { name: string; nameLatin: string };
}
const { current } = Astro.props;
type Crumb = { label: string; latin: string; href?: string; current?: boolean };
const trail: Crumb[] = [
  { label: ATTRACTION.country, latin: ATTRACTION.countryLatin },
  { label: ATTRACTION.region, latin: ATTRACTION.regionLatin },
  { label: ATTRACTION.city, latin: ATTRACTION.cityLatin },
  { label: ATTRACTION.fullName, latin: ATTRACTION.fullNameLatin, href: `${SITE_URL}/` },
];
if (current) trail.push({ label: current.name, latin: current.nameLatin, current: true });
else trail[trail.length - 1].current = true;
---
<nav class="breadcrumbs" aria-label="جغرافیائی درجہ بندی">
  <ol>
    {
      trail.map((step) => (
        <li aria-current={step.current ? 'page' : undefined}>
          {step.href && !step.current ? (
            <a class="bc-ur" href={step.href}>{step.label}</a>
          ) : (
            <span class="bc-ur">{step.label}</span>
          )}
          <span class="bc-latin" dir="ltr">{step.latin}</span>
        </li>
      ))
    }
  </ol>
</nav>
