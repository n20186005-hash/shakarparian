---
import { ATTRACTION, OFFICIAL_SOURCES } from '../data/site';
import { localeFromUrl, type Locale } from '../i18n';

interface Props {
  sources?: readonly { readonly label: string; readonly labelEn: string; readonly href: string }[];
}
const { sources = OFFICIAL_SOURCES } = Astro.props;
const locale: Locale = localeFromUrl(Astro.url);
const L = locale === 'en' ? {
  eyebrow: 'References & sources',
  title: 'Editorial method and key sources',
  p1: 'This is an independent, non-profit information page. Historical, civic, and transport context has been compiled from public/official material. We do not claim an artificial “last verified” date for changing information; check the live status with the relevant body on the day of your visit.',
  p2: 'Location, rating ({rating} / 5, {count} reviews) and the listed general hours come from the linked Google Maps place and public map listing. Map pin: {plus}.',
  p3: 'Images: CC BY-SA 4.0 photography by Fawad4real on Wikimedia Commons; the visible photo credits below link to each original and its licence.',
  sourceLabel: 'source label',
} : {
  eyebrow: 'حوالہ جات اور مآخذ',
  title: 'اداریاتی طریقہ اور بنیادی ماخذ',
  p1: 'یہ ایک غیر سرکاری، غیر منافع بخش معلوماتی صفحہ ہے۔ تاریخی، شہری اور ٹرانسپورٹ پس منظر کو سرکاری/عوامی اداروں کے مواد سے تقابل کیا گیا ہے۔ بدلنے والی معلومات کے لیے ہم تاریخِ “آخری تصدیق” جیسا مصنوعی دعویٰ نہیں کرتے؛ روانگی کے دن اصل ادارے سے موجودہ حالت دیکھیں۔',
  p2: 'مقام، درجہ بندی ({rating} / 5، {count} آراء) اور درج عمومی اوقات: فراہم کردہ گوگل میپس مقام اور عوامی نقشہ فہرست۔ نقشے کا پن: {plus}',
  p3: 'تصاویر: Wikimedia Commons پر Fawad4real کی CC BY-SA 4.0 فوٹوگرافی؛ ہر اصل تصویر اور لائسنس کے روابط نیچے تصویری انتساب میں ہیں۔',
  sourceLabel: 'source label',
};
const labelKey = locale === 'en' ? 'labelEn' : 'label';
---
<section class="section-sm" id="sources" aria-labelledby="sources-title">
  <div class="container source-box">
    <div class="eyebrow">{L.eyebrow}</div>
    <h2 class="section-title" id="sources-title">{L.title}</h2>
    <p>
      {locale === 'en' ? 'Sources checked on 20 October 2026. The Google snapshot applies to the park listing only; monument and museum tickets, hours and access are separate. Pin coordinates are a location reference, not a verified entrance or accessible route. Check operators before travel.' : 'ماخذ 20 اکتوبر 2026 کو دیکھے گئے۔ گوگل کا ریکارڈ صرف پارک کی فہرست ہے؛ مونومنٹ اور ہر میوزیم کے ٹکٹ، اوقات اور رسائی الگ ہیں۔ پن صرف مقام کا حوالہ ہے، تصدیق شدہ داخلی یا قابل رسائی راستہ نہیں۔ سفر سے پہلے متعلقہ ادارے سے معلوم کریں۔'}
    </p>
    <ol class="source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.href} target="_blank" rel="noopener noreferrer">
              {source[labelKey]}
            </a>
          </li>
        ))
      }
    </ol>
    <p class="source-meta">
      {L.p2.replace('{rating}', ATTRACTION.ratingValue).replace('{count}', ATTRACTION.ratingCountLabel).replace('{plus}', ATTRACTION.pinReference)}
    </p>
    <p>
      {L.p3}
    </p>
  </div>
</section>
