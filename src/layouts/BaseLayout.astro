---
import '../styles/global.css';
import Brand from '../components/Brand.astro';
import Footer from '../components/Footer.astro';
import { ATTRACTION, SITE_NAME } from '../data/site';
import { localeFromUrl, hreflangAlternates, localizedPath, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  ogTitle?: string;
  noHeader?: boolean;
}
const { title, description, image = '/brand/favicon.svg', imageAlt, ogTitle, noHeader = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImage = Astro.site && image.startsWith('/') ? new URL(image, Astro.site).toString() : image;
const socialTitle = ogTitle ?? title;
const socialImageAlt = imageAlt ?? `${SITE_NAME} — ${title}`;

const locale: Locale = localeFromUrl(Astro.url);
const langAttr = locale === 'en' ? 'en' : 'ur-PK';
const dirAttr = locale === 'en' ? 'ltr' : 'rtl';
const ogLocale = locale === 'en' ? 'en_US' : 'ur_PK';
const alternates = hreflangAlternates(Astro.url.pathname);
const navHref = (hash: string) => (locale === 'en' ? `/en${hash}` : hash);
const otherLocale: Locale = locale === 'en' ? 'ur' : 'en';
const switchHref = localizedPath(Astro.url.pathname, otherLocale);
const switchLabel = locale === 'en' ? 'اردو' : 'English';
const skipText = locale === 'en' ? 'Skip to main content' : 'مرکزی مواد پر جائیں';
const navAria = locale === 'en' ? 'Primary navigation' : 'مرکزی نیویگیشن';
---
<!doctype html>
<html lang={langAttr} dir={dirAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123d33" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="geo.region" content="PK-IS" />
    <meta name="geo.placename" content={`${ATTRACTION.fullNameLatin}, ${ATTRACTION.cityLatin}`} />
    <meta name="geo.position" content={`${ATTRACTION.latitude};${ATTRACTION.longitude}`} />
    <meta name="ICBM" content={`${ATTRACTION.latitude}, ${ATTRACTION.longitude}`} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      (() => {
        const GA_ID = 'G-HXM22WWPKP';
        const key = 'shakarparian-consent';
        const loadAnalytics = () => {
          if (document.querySelector('script[data-ga-loader]')) return;
          const s = document.createElement('script');
          s.async = true;
          s.dataset.gaLoader = 'true';
          s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments)}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID, { anonymize_ip: true });
        };
        try {
          const prefs = JSON.parse(localStorage.getItem(key) || '{}');
          if (prefs.analytics === true) loadAnalytics();
        } catch {}
        window.addEventListener('shakarparian-consent-changed', (event) => {
          if (event.detail?.analytics === true) loadAnalytics();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipText}</a>
    {!noHeader && (
      <header class="site-header">
        <div class="container header-row">
          <Brand compact href={locale === 'en' ? '/en/' : '/'} />
          <nav class="nav" aria-label={navAria}>
            <a href={navHref('/#history')}>{locale === 'en' ? 'Background' : 'پس منظر'}</a>
            <a href={navHref('/#visit')}>{locale === 'en' ? 'Plan your visit' : 'دورے کی منصوبہ بندی'}</a>
            <a href={navHref('/#transport')}>{locale === 'en' ? 'Getting there' : 'آمدورفت'}</a>
            <a href={navHref('/#nearby')}>{locale === 'en' ? 'Nearby' : 'قریب کیا ہے'}</a>
            <a href={navHref('/#faq')}>{locale === 'en' ? 'FAQ' : 'سوالات'}</a>
            <a class="nav-cta" href={navHref('/#map')}>{locale === 'en' ? 'View map' : 'نقشہ دیکھیں'}</a>
            <a class="nav-lang" href={switchHref} hreflang={otherLocale}>{switchLabel}</a>
          </nav>
        </div>
      </header>
    )}
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
