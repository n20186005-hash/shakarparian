          <img src={parkPhoto} alt="پاکستان مونومنٹ کی پتھریلی پنکھڑیاں اور سیڑھیاں، ستمبر 2018 کی تصویر" width="1200" height="675" loading="lazy" />
          <figcaption class="caption">پاکستان مونومنٹ، 2018 · Fawad4real · <a href="#photo-credits">اصل فائل، لائسنس اور تبدیلیاں</a></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="eyebrow">عمومی سوالات</div>
      <h2 class="section-title">دورے سے پہلے اکثر پوچھے جانے والے سوال</h2>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <SourcesSection />
</BaseLayout>
