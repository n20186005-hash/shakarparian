---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubHero from '../../components/SubHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import { ATTRACTION, SITE_URL, withSiteName } from '../../data/site';
import { buildBreadcrumbSchema, buildFaqSchema } from '../../lib/schema';

const heroPhoto = '/images/monument-03.jpg';
const monumentPhoto = '/images/monument-05.jpg';

const siteUrl = (Astro.site?.toString().replace(/\/$/, '') || SITE_URL).replace(/\/$/, '');
const pageUrl = `${siteUrl}/pakistan-monument/`;
const crumb = { name: 'پاکستان مونومنٹ اور میوزیم', nameLatin: 'Pakistan Monument & Museum' };
const breadcrumbSchema = buildBreadcrumbSchema(pageUrl, crumb);

const faqs: [string, string][] = [
  ['پاکستان مونومنٹ کیا ہے؟', 'پاکستان مونومنٹ شکرپڑیاں کی مغربی پہاڑی پر قومی وحدت کی علامتی یادگار ہے۔ قریب پاکستان مونومنٹ میوزیم لوک ورثہ کا الگ اندرونی ادارہ ہے۔'],
  ['کیا مونومنٹ اور میوزیم ایک ہی جگہ ہیں؟', 'قریب پاکستان مونومنٹ میوزیم ایک الگ ادارہ ہے۔ اس کا داخلی مقام، ٹکٹ اور اوقات پارک اور کھلی یادگار سے الگ معلوم کریں۔'],
  ['کیا یہ شکرپڑیاں نیشنل پارک کے دورے میں شامل ہے؟', `${ATTRACTION.fullName} کا مرکزی سبز علاقہ اور پاکستان مونومنٹ ایک ہی تفریحی منظرنامے کا حصہ ہیں۔ نصف دن میں مشترکہ دورہ صرف منصوبے کی مثال ہے؛ ہر مقام کے کھلنے، ٹکٹ اور راستے کی تصدیق کریں اور اپنی رفتار کے مطابق بدلیں۔`],
  ['تصویر کشی کے لیے بہترین وقت کون سا ہے؟', 'صبح یا غروب سے پہلے کی روشنی تصویر کشی کے منصوبے کی پسند ہے، جو تصدیق شدہ اوقات، موسم اور سکیورٹی پابندیوں سے مشروط ہے؛ طلوع کے وقت یا یادگار کی چوٹی تک رسائی کی تصدیق نہیں ہوئی۔'],
];
const faqSchema = buildFaqSchema(faqs);
---
<BaseLayout
  title={withSiteName('پاکستان مونومنٹ اور میوزیم (اسلام آباد)')}
  ogTitle={`Pakistan Monument & Museum — ${ATTRACTION.cityLatin} | ${ATTRACTION.fullNameLatin}`}
  description={`پاکستان مونومنٹ (اسلام آباد، شکرپڑیاں) کی پنکھڑیوں والی علامتی یادگار اور اس کے میوزیم کا غیر تجارتی اردو تعارف: مقام، اندرونی نمائش، دورے کا وقت اور پارک کے ساتھ امتزاج۔`}
  image={monumentPhoto}
  imageAlt="پاکستان مونومنٹ، 2018؛ پارک کی فہرست سے الگ مقام"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <SubHero
    kicker="قومی یادگار اور عجائب گھر"
    title="پاکستان مونومنٹ اور میوزیم"
    latin="Pakistan Monument & Museum — Shakarparian, Islamabad"
    lead={`شکرپڑیاں کی مغربی پہاڑی پر قومی وحدت کی یہ علامتی یادگار اور اس کا میوزیم ${ATTRACTION.city} کے وسیع منظر کے ساتھ ملتے ہیں۔ یہ صفحہ یادگار کی ساخت، مواد، اندرونی نمائش اور دورے کے عملی نکات پر غیر تجارتی رہنمائی فراہم کرتا ہے۔`}
    image={monumentPhoto}
    imageAlt="پاکستان مونومنٹ، 2018؛ پارک کی فہرست سے الگ مقام"
  />

  <div class="container breadcrumb-bar">
    <Breadcrumbs current={crumb} />
  </div>

  <section class="section-sm" aria-labelledby="about-monument">
    <div class="container story-grid">
      <div class="story-copy">
        <div class="eyebrow">یادگار کو سمجھیں</div>
        <h2 class="section-title" id="about-monument">پاکستان مونومنٹ: پنکھڑیوں میں لپٹی ہوئی قومی کہانی</h2>
        <p>
          پاکستان مونومنٹ کی سب سے نمایاں بات اس کا پھول جیسا ڈھانچہ ہے جس کی پنکھڑیاں پاکستان کے چار صوبوں — پنجاب، سندھ، خیبر پختونخوا اور بلوچستان — کے ساتھ ساتھ گلگت بلتستان اور آزاد کشمیر جیسے علاقوں کی عکاسی کرتی ہیں۔ یہ ساخت “اکٹھے رہنے” اور وفاقی یکجہتی کی علامت ہے۔
        </p>
        <p>پاکستان مونومنٹ میوزیم لوک ورثہ کا الگ اندرونی ادارہ ہے۔ موجودہ نمائش، ٹکٹ اور داخلی مقام متعلقہ ادارے سے معلوم کریں۔</p>
        <p>
          یادگار اور <strong>{ATTRACTION.fullName}</strong> شکرپڑیاں کے علاقے میں الگ سیاحتی مقامات ہیں؛ جغرافیائی تعلق سے کھلے رابطہ راستے کی تصدیق نہیں ہوتی۔
        </p>
      </div>
      <div class="story-image">
        <img src={heroPhoto} alt={`پاکستان مونومنٹ کا مرکزی نظارہ — ${ATTRACTION.fullName}، ${ATTRACTION.city}`} width="1600" height="1067" loading="lazy" />
        <div class="story-badge">نصف دن کے منصوبے کی مثال: سبزہ → یادگار → میوزیم → ثقافتی ادارے؛ پہلے ہر مقام کے کھلنے، ٹکٹ اور راستے معلوم کریں اور اپنی رفتار کے مطابق بدلیں۔</div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="what-inside">
    <div class="container">
      <div class="eyebrow">میوزیم کا موضوع اور رسائی</div>
      <h2 class="section-title" id="what-inside">میوزیم کے موضوعات اور ضروری تصدیق</h2>
      <p>ماخذ 20 اکتوبر 2026 کو دیکھا گیا: <a href="https://lokvirsa.org.pk/pakistan-monument-museum/">لوک ورثہ کا پاکستان مونومنٹ میوزیم تعارف</a>۔ اس میں قومی تاریخ، آزادی اور بعد کی کامیابیوں کا ذکر ہے؛ یہ آج کھلی نمائشوں کی تاریخ وار فہرست نہیں۔</p>
      <div class="feature-grid">
        <article class="feature"><div class="icon" aria-hidden="true">✦</div><h3>تاریخی موضوعات</h3><p>سرکاری تعارف میوزیم کا تاریخی موضوع بتاتا ہے۔ موجودہ کھلی گیلریوں اور انفرادی نمائشوں کے بارے میں لوک ورثہ سے معلوم کریں۔</p></article>
        <article class="feature"><div class="icon" aria-hidden="true">◎</div><h3>میوزیم کا دورہ</h3><p>داخلی مقام، ٹکٹ، اوقات اور کسی سمعی و بصری پروگرام کی دستیابی الگ معلوم کریں؛ پارک کی فہرست ان کی تصدیق نہیں کرتی۔</p></article>
        <article class="feature"><div class="icon" aria-hidden="true">☼</div><h3>نظارے کی رسائی</h3><p><a href="https://www.cda.gov.pk/destination">سی ڈی اے کا مقامات کا تعارف</a> شکرپڑیاں کے شہری منظر کا ذکر کرتا ہے، یادگار پر چڑھنے کی اجازت کا نہیں۔ یادگار کی چوٹی اور طلوع کے وقت داخلہ غیر مصدقہ ہیں؛ صرف عملے کے بتائے کھلے حصوں میں رہیں۔</p></article>
      </div>
      <p class="notice" style="margin-top:1.6rem"><strong>دورے کے دن:</strong> ہر آپریٹر سے موجودہ اوقات، نمائش کی دستیابی، ٹکٹ کی شرائط اور سکیورٹی پابندیاں سفر سے پہلے معلوم کریں۔</p>
    </div>
  </section>

  <section class="section-sm deep-green" aria-labelledby="combo">
    <div class="container">
      <div class="eyebrow">پارک کے ساتھ امتزاج</div>
      <h2 class="section-title" id="combo">ایک ہی دورے میں فطرت اور تاریخ</h2>
      <p class="section-lead">{ATTRACTION.fullName}، یادگار اور قریبی اداروں کا مشترکہ دورہ ایک اختیاری تجویز ہے۔ ہر مقام کے کھلنے، ٹکٹ اور اسی دن کے اصل رابطہ راستے کی تصدیق کے بعد ہی اپنائیں؛ وقت اور محنت اپنی رفتار اور حالات پر منحصر ہیں۔</p>
      <div class="guide-grid">
        <article class="guide-card">
          <h3>سیر کا ترتیب</h3>
          <p>اختیاری ترتیب: سبزہ → یادگار → اندرونی میوزیم۔ ہر مقام کے اوقات، ٹکٹ اور اسی دن کے اصل رابطہ راستوں کی تصدیق کے بعد ہی اپنائیں یا بدلیں؛ مسلسل پیدل راستہ یا تکمیلی وقت تصدیق شدہ نہیں۔</p>
        </article>
        <article class="guide-card">
          <h3>وقت کی تقسیم</h3>
          <p>منصوبے کی مثال کے طور پر صرف یادگار کے لیے 1–2 گھنٹے یا پارک اور عجائب گھروں کے ساتھ نصف دن رکھ سکتے ہیں۔ یہ ناپا ہوا تکمیلی وقت نہیں؛ ہر مقام کے کھلنے، ٹکٹ اور راستے کی تصدیق کریں اور اپنی رفتار کے مطابق بدلیں۔</p>
        </article>
        <article class="guide-card">
          <h3>تصویر کشی</h3>
          <p>عملہ کسی عوامی حصے کے کھلنے کی تصدیق کرے تو اسی کے اندر تصویر کی جگہ چنیں اور سکیورٹی ہدایات مانیں۔ یہ رہنما پہاڑی کے کناروں یا یادگار کی چوٹی تک رسائی کی تصدیق نہیں کرتا۔</p>
        </article>
        <article class="guide-card">
          <h3>رسائی</h3>
          <p>اپنا مطلوبہ الگ مقام واضح کریں۔ سواری طے کرنے سے پہلے متعلقہ آپریٹر سے داخلی مقام اور قانونی سوار ہونے یا اترنے کی جگہ معلوم کریں۔</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-sm" aria-labelledby="monument-faq">
    <div class="container">
      <div class="eyebrow">عمومی سوالات</div>
      <h2 class="section-title" id="monument-faq">مونومنٹ اور میوزیم سے متعلق سوالات</h2>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RelatedGuides exclude="pakistan-monument" />
  <SourcesSection />
</BaseLayout>
